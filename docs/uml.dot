digraph UML {
  graph [rankdir=BT, splines=polyline, nodesep=0.5, ranksep=1.1, fontname="DejaVu Sans", labelloc=t, fontsize=20, label="Tic Tac Toe - diagram klas UML", pad=0.3, bgcolor=white];
  node [shape=plain, fontname="DejaVu Sans", fontsize=11];
  edge [fontname="DejaVu Sans", fontsize=10];
  Player [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD ALIGN="CENTER" BGCOLOR="#FFFDF2"><FONT POINT-SIZE="10">«abstract»</FONT><BR/><B><I>Player</I></B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- name_ : string<BR ALIGN="LEFT"/>- symbol_ : char<BR ALIGN="LEFT"/>+ UNDO_MOVE : int {static constexpr}<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Player()<BR ALIGN="LEFT"/>+ Player(name, symbol)<BR ALIGN="LEFT"/>+ ~Player() {virtual}<BR ALIGN="LEFT"/>+ chooseMove(board : Board&amp;) : pair&lt;int,int&gt; {abstract, const}<BR ALIGN="LEFT"/>+ describe() : string {virtual, const}<BR ALIGN="LEFT"/>+ isInteractive() : bool {virtual, const}<BR ALIGN="LEFT"/>+ getName() : string&amp; {const}<BR ALIGN="LEFT"/>+ getSymbol() : char {const}<BR ALIGN="LEFT"/>+ setName(name)<BR ALIGN="LEFT"/>+ setSymbol(symbol)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  HumanPlayer [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD ALIGN="CENTER" BGCOLOR="#FFFDF2"><B>HumanPlayer</B></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ HumanPlayer(name, symbol)<BR ALIGN="LEFT"/>+ chooseMove(board) : pair&lt;int,int&gt; {override, const}<BR ALIGN="LEFT"/>+ describe() : string {override, const}<BR ALIGN="LEFT"/>+ isInteractive() : bool {override, const}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ComputerPlayer [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD ALIGN="CENTER" BGCOLOR="#FFFDF2"><B>ComputerPlayer</B></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ ComputerPlayer(name, symbol)<BR ALIGN="LEFT"/>+ chooseMove(board) : pair&lt;int,int&gt; {override, const}<BR ALIGN="LEFT"/>+ describe() : string {override, const}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Board [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD ALIGN="CENTER" BGCOLOR="#FFFDF2"><B>Board</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ SIZE : int {static const} = 3<BR ALIGN="LEFT"/>- cells_ : array&lt;array&lt;char,3&gt;,3&gt;<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Board()<BR ALIGN="LEFT"/>+ placeMark(row, col, symbol) : void<BR ALIGN="LEFT"/>+ clearCell(row, col) : bool<BR ALIGN="LEFT"/>+ reset() : void<BR ALIGN="LEFT"/>+ getCell(row, col) : char {const}<BR ALIGN="LEFT"/>+ isFull() : bool {const}<BR ALIGN="LEFT"/>+ isCellFree(row, col) : bool {const}<BR ALIGN="LEFT"/>+ checkWinner() : char {const}<BR ALIGN="LEFT"/>- inRange(row, col) : bool {const}<BR ALIGN="LEFT"/>+ operator&lt;&lt;(os, board) : ostream&amp;  «non-member»<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Game [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD ALIGN="CENTER" BGCOLOR="#FFFDF2"><B>Game</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- board_ : Board<BR ALIGN="LEFT"/>- history_ : MoveHistory<BR ALIGN="LEFT"/>- players_ : unique_ptr&lt;Player&gt;[2]<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Game(first, second)<BR ALIGN="LEFT"/>+ run() : const Player*<BR ALIGN="LEFT"/>+ getPlayer(index) : Player&amp; {const}<BR ALIGN="LEFT"/>+ getHistory() : MoveHistory&amp; {const}<BR ALIGN="LEFT"/>- undo(turn : int&amp;) : void<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Move [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD ALIGN="CENTER" BGCOLOR="#FFFDF2"><B>Move</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- row_ : int<BR ALIGN="LEFT"/>- col_ : int<BR ALIGN="LEFT"/>- symbol_ : char<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ Move()<BR ALIGN="LEFT"/>+ Move(row, col, symbol)<BR ALIGN="LEFT"/>+ getRow() : int {const}<BR ALIGN="LEFT"/>+ getCol() : int {const}<BR ALIGN="LEFT"/>+ getSymbol() : char {const}<BR ALIGN="LEFT"/>+ describe() : string {const}<BR ALIGN="LEFT"/>+ operator&lt;&lt;(os, move) : ostream&amp;  «non-member»<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  MoveHistory [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD ALIGN="CENTER" BGCOLOR="#FFFDF2"><B>MoveHistory</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- moves_ : vector&lt;Move&gt;<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ add(move) : void<BR ALIGN="LEFT"/>+ removeLast() : bool<BR ALIGN="LEFT"/>+ findByTurn(turn) : Move* {const}<BR ALIGN="LEFT"/>+ last() : Move&amp; {const}<BR ALIGN="LEFT"/>+ isEmpty() : bool {const}<BR ALIGN="LEFT"/>+ size() : size_t {const}<BR ALIGN="LEFT"/>+ clear() : void<BR ALIGN="LEFT"/>+ print() : void {const}<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  ScoreBoard [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD ALIGN="CENTER" BGCOLOR="#FFFDF2"><B>ScoreBoard</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- records_ : vector&lt;PlayerRecord&gt;<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ addPlayer(name) : void<BR ALIGN="LEFT"/>+ findPlayer(name) : PlayerRecord*<BR ALIGN="LEFT"/>+ renamePlayer(oldName, newName) : void<BR ALIGN="LEFT"/>+ removePlayer(name) : void<BR ALIGN="LEFT"/>+ recordWin(winner, loser) : void<BR ALIGN="LEFT"/>+ recordDraw(first, second) : void<BR ALIGN="LEFT"/>+ isEmpty() : bool {const}<BR ALIGN="LEFT"/>+ print() : void {const}<BR ALIGN="LEFT"/>- getOrCreate(name) : PlayerRecord&amp;<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  PlayerRecord [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD ALIGN="CENTER" BGCOLOR="#FFFDF2"><B>PlayerRecord</B></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">- name_ : string<BR ALIGN="LEFT"/>- wins_ : int<BR ALIGN="LEFT"/>- losses_ : int<BR ALIGN="LEFT"/>- draws_ : int<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ PlayerRecord()<BR ALIGN="LEFT"/>+ PlayerRecord(name)<BR ALIGN="LEFT"/>+ getName() / getWins() / getLosses()<BR ALIGN="LEFT"/>+ getDraws() / getGamesPlayed()  {const}<BR ALIGN="LEFT"/>+ setName(name)<BR ALIGN="LEFT"/>+ addWin() / addLoss() / addDraw()<BR ALIGN="LEFT"/>+ operator==(a, b) : bool  «non-member»<BR ALIGN="LEFT"/>+ operator&lt;(a, b) : bool  «non-member»<BR ALIGN="LEFT"/>+ operator&lt;&lt;(os, record) : ostream&amp;  «non-member»<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  runtime_error [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD ALIGN="CENTER" BGCOLOR="#E8E8E8"><B>std::runtime_error</B></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
  GameException [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD ALIGN="CENTER" BGCOLOR="#EEF3FB"><B>GameException</B></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ GameException(message)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  InvalidMoveException [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD ALIGN="CENTER" BGCOLOR="#EEF3FB"><B>InvalidMoveException</B></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
  CellOccupiedException [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD ALIGN="CENTER" BGCOLOR="#EEF3FB"><B>CellOccupiedException</B></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
  ScoreBoardException [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD ALIGN="CENTER" BGCOLOR="#EEF3FB"><B>ScoreBoardException</B></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
  InputClosedException [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD ALIGN="CENTER" BGCOLOR="#EEF3FB"><B>InputClosedException</B></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ InputClosedException()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  HumanPlayer -> Player [arrowhead=onormal, style=solid];
  ComputerPlayer -> Player [arrowhead=onormal, style=solid];
  GameException -> runtime_error [arrowhead=onormal, style=solid];
  InputClosedException -> runtime_error [arrowhead=onormal, style=solid];
  InvalidMoveException -> GameException [arrowhead=onormal, style=solid];
  ScoreBoardException -> GameException [arrowhead=onormal, style=solid];
  CellOccupiedException -> InvalidMoveException [arrowhead=onormal, style=solid];
  Game -> Board [dir=back, arrowtail=diamond, headlabel="1", label="", arrowhead=none, taillabel=""];
  Game -> MoveHistory [dir=back, arrowtail=diamond, headlabel="1", label="", arrowhead=none, taillabel=""];
  Game -> Player [dir=back, arrowtail=diamond, headlabel="2", label="players_", arrowhead=none, taillabel=""];
  MoveHistory -> Move [dir=back, arrowtail=diamond, headlabel="0..*", label="", arrowhead=none, taillabel=""];
  ScoreBoard -> PlayerRecord [dir=back, arrowtail=diamond, headlabel="0..*", label="", arrowhead=none, taillabel=""];
  Player -> Board [style=dashed, arrowhead=vee, label="uses"];
  Game -> Move [style=dashed, arrowhead=vee, label="creates"];
  Board -> InvalidMoveException [style=dashed, arrowhead=vee, label="throws"];
  Board -> CellOccupiedException [style=dashed, arrowhead=vee, label="throws"];
  HumanPlayer -> InvalidMoveException [style=dashed, arrowhead=vee, label="throws"];
  Game -> InvalidMoveException [style=dashed, arrowhead=vee, label="catches"];
  ScoreBoard -> ScoreBoardException [style=dashed, arrowhead=vee, label="throws"];
}